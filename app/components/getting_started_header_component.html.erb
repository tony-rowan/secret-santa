<div class="flex flex-col items-center gap-4 text-center">
  <span class="<%= tile_classes %>">
    <%= icon(icon_name.to_s, size: "size-11") %>
  </span>
  <h1 class="<%= title_classes %>"><%= title || "Secret Santa" %></h1>
  <% unless title %>
    <p class="-mt-1.5"><%= render MuddleBylineComponent.new(large: true) %></p>
  <% end %>
  <% if subtitle %>
    <p class="text-[17px] text-lilac-300 max-w-[310px]"><%= subtitle %></p>
  <% end %>
</div>
