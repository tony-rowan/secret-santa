<section aria-labelledby="email-heading" class="card">
  <div class="flex flex-col gap-1">
    <h2 id="email-heading" class="card-title">Email</h2>
    <p class="card-hint">You sign in with <strong class="text-snow font-semibold break-all"><%= user.email %></strong></p>
  </div>

  <%= form_with(model: user, class: "flex flex-col gap-2") do |form| %>
    <%= form.label :email, "New email address", class: "font-semibold" %>
    <% if error %>
      <p class="text-sm text-berry-light"><%= error %></p>
    <% end %>
    <%= form.email_field :email,
      tailwindified: true,
      value: new_email,
      required: true,
      autocomplete: "email",
      placeholder: "you@example.com",
      class: "input-field #{"border-berry-light" if error}" %>
    <%= form.button "Send verification link", class: "button min-h-13 text-base" %>
    <p class="card-hint">Your email only changes once you click the link we send to the new address.</p>
  <% end %>

  <%= render Account::PendingEmailComponent.new(user:) %>
</section>
