<template id="<%= id %>">
  <% if icon_name %>
    <span data-confirm-icon class="size-14 rounded-[18px] bg-berry/20 text-[#ff8a8a] flex items-center justify-center">
      <%= icon(icon_name, size: "size-7") %>
    </span>
  <% end %>

  <% if removed.any? || kept.any? %>
    <ul class="flex flex-col gap-3 text-lilac-200">
      <% removed.each do |item| %>
        <li class="flex gap-3">
          <%= icon(:x_mark, size: "size-5", class: "text-[#ff8a8a] mt-0.5", "stroke-width": 2) %>
          <span><%= item %></span>
        </li>
      <% end %>
      <% kept.each do |item| %>
        <li class="flex gap-3">
          <%= icon(:check, size: "size-5", class: "text-pine-light mt-0.5", "stroke-width": 2) %>
          <span><%= item %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if warning %>
    <div class="flex gap-3 px-4 py-3.5 rounded-2xl bg-gold/12 border border-gold/40 text-[15px] text-gold">
      <%= icon(:exclamation_triangle, size: "size-5", class: "mt-0.5") %>
      <span><%= warning %></span>
    </div>
  <% end %>

  <% if note %>
    <p class="text-sm text-lilac-400"><%= note %></p>
  <% end %>
</template>
<%= content %>
