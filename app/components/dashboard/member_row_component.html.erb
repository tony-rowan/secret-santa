<li class="list-row min-h-14 gap-3 py-1.5 pl-3.5 pr-1.5">
  <div class="grow min-w-0 flex flex-col gap-0.5">
    <span class="font-semibold break-words"><%= member.name %></span>
    <span class="text-[13px] <%= details_class %>"><%= details %></span>
  </div>

  <% if removable? %>
    <%= render ConfirmationComponent.new(**remove_confirmation) do |confirmation| %>
      <%= button_to group_membership_path(group, member),
        method: :delete,
        class: "shrink-0 min-h-11 px-3 rounded-xl border-[1.5px] border-night-600 text-berry-light hover:bg-berry/20 text-sm font-semibold flex items-center gap-1.5",
        title: remove_label,
        aria: { label: remove_label },
        data: confirmation.data do %>
        <%= icon(:x_mark, size: "size-4.5") %>
        Remove
      <% end %>
    <% end %>
  <% end %>
</li>
