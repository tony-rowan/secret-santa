<section aria-labelledby="invite-heading" class="card gap-1 py-5.5">
  <h2 id="invite-heading" class="font-display font-bold text-3xl leading-tight break-words"><%= group.name %></h2>
  <p class="text-lilac-400">Organised by <%= group.owner.name %></p>
</section>

<%= form_with(model: form, url: join_path) do |f| %>
  <%= f.hidden_field :invite_token %>
  <%= f.button "Join #{group.name}", class: "button w-full" %>
<% end %>
