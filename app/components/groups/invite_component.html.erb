<div class="contents" data-controller="invite" data-invite-share-value="<%= share_data.to_json %>">
  <button type="button" class="<%= classes %>" data-action="invite#open">
    <%= icon(:user_plus, size: "size-5") %>
    Invite others
  </button>

  <dialog
    aria-labelledby="<%= dialog_title_id %>"
    class="m-auto w-[calc(100%-2.5rem)] max-w-md p-0 bg-transparent text-snow backdrop:bg-[#080618]/75"
    data-invite-target="dialog"
    data-action="click->invite#backdropClick">
    <div class="relative rounded-3xl bg-night-800 border border-white/14 shadow-2xl shadow-black/50 p-6 flex flex-col gap-4.5">
      <button type="button" aria-label="Close" class="icon-button absolute top-3 right-3" data-action="invite#close">
        <%= icon(:x_mark, size: "size-5.5") %>
      </button>

      <div class="self-center flex items-center justify-center size-14 rounded-[18px] bg-gold/16 text-gold">
        <%= icon(:user_plus, size: "size-7") %>
      </div>

      <h2 id="<%= dialog_title_id %>" class="px-8 text-center font-display font-bold text-[28px] leading-tight">Invite others</h2>

      <p class="text-center text-lilac-200">Send this link to everyone you want in <%= group.name %>, by message or email. Opening it lets them join.</p>

      <div class="flex flex-col gap-2">
        <label for="invite-link-<%= group.id %>" class="font-semibold text-[15px]">Invite link</label>
        <input type="text" id="invite-link-<%= group.id %>" value="<%= invite_link %>" readonly autocomplete="off" class="input-field text-[15px]" data-action="focus->invite#select">
      </div>

      <p class="text-sm text-lilac-400">The link works until you draw names. After that, no one new can join.</p>

      <div class="flex flex-col gap-2.5 mt-1">
        <button type="button" class="button" data-action="invite#copy">
          <%= icon(:document_duplicate, size: "size-5") %>
          <span data-invite-target="copyLabel">Copy link</span>
        </button>
        <button type="button" class="button-secondary bg-transparent min-h-14 text-lg" data-action="invite#close">Done</button>
      </div>
    </div>
  </dialog>
</div>
