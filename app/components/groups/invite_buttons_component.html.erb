<div class="grid grid-cols-2 gap-2">
  <button type="button"
    class="button-secondary px-3 whitespace-nowrap <%= button_class %>"
    data-controller="clipboard"
    data-clipboard-text-value="<%= group.formatted_join_code %>"
    data-clipboard-feedback-value="Copied!"
    data-action="clipboard#copy">
    <%= icon(:document_duplicate, size: "size-5") %>
    <span data-clipboard-target="label">Copy code</span>
  </button>

  <%= link_to join_url,
    class: "button-secondary px-3 whitespace-nowrap #{button_class}",
    data: {
      controller: "share",
      share_fallback_copy_feedback_value: "Link copied!",
      share_data_value: share_data,
      action: "share#share"
    } do %>
    <%= icon(:arrow_up_tray, size: "size-5") %>
    <span data-share-target="fallbackCopyFeedback">Share link</span>
  <% end %>
</div>
