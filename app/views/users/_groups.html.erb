<%# locals: (user:, groups:) %>

<section aria-labelledby="groups-heading" class="card">
  <h2 id="groups-heading" class="card-title">Your groups</h2>

  <% if groups.any? %>
    <ul class="flex flex-col gap-2">
      <% groups.each do |group| %>
        <li class="list-row min-h-14 gap-3 py-1.5 pl-3.5 pr-1.5">
          <%= link_to dashboard_path(group_id: group.id), class: "grow min-w-0 flex flex-col gap-0.5 text-snow hover:text-gold-light no-underline" do %>
            <span class="font-semibold break-words"><%= group.name %></span>
            <% if group.owner?(user) %>
              <span class="text-[13px] font-semibold text-gold">Organised by you</span>
            <% else %>
              <span class="text-[13px] text-lilac-400">Organised by <%= group.owner.name %></span>
            <% end %>
          <% end %>

          <% unless group.owner?(user) %>
            <%= render "shared/confirm_details",
              id: "confirm-leave-#{group.id}",
              icon_name: :arrow_right_start_on_rectangle,
              removed: [
                "You leave #{group.name}",
                "Your gift ideas for this group are deleted",
                ("Drawn names are cleared, so they'll need drawing again" if group.pairs.any?)
              ].compact,
              note: "You can join again with the code." %>
            <%= button_to "Leave", group_membership_path(group, user),
              method: :delete,
              class: "shrink-0 min-h-11 px-3.5 rounded-xl border-[1.5px] border-night-600 text-berry-light hover:bg-berry/20 text-sm font-semibold",
              title: "Leave #{group.name}",
              aria: { label: "Leave #{group.name}" },
              data: {
                turbo_confirm: "Leave #{group.name}?",
                confirm_button: "Yes, leave",
                confirm_details: "confirm-leave-#{group.id}"
              } %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%= link_to join_path, class: "button-secondary bg-night-900" do %>
      <%= icon(:plus, size: "size-5", "stroke-width": 2.4) %>
      Join another group
    <% end %>
  <% else %>
    <div class="flex flex-col items-center gap-2.5 px-4 py-6 rounded-2xl border-[1.5px] border-dashed border-[#2f6b48] bg-night-900 text-center">
      <svg width="128" height="96" viewBox="0 0 128 96" fill="none" stroke="#3f8a5c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 20h3M15.5 18.5v3" />
        <path d="M108 12h4M110 10v4" />
        <path d="M114 50h3M115.5 48.5v3" />
        <circle cx="40" cy="44" r="9" />
        <path d="M24 80c0-10 7-17 16-17s16 7 16 17" />
        <circle cx="88" cy="44" r="9" />
        <path d="M72 80c0-10 7-17 16-17s16 7 16 17" />
        <circle cx="64" cy="34" r="11" />
        <path d="M44 80c0-13 9-22 20-22s20 9 20 22" />
        <path d="M56 22l3-8 5 5 5-5 3 8" />
      </svg>
      <p class="font-display font-bold text-xl">No groups yet</p>
      <p class="text-sm text-lilac-400 max-w-65">Join with a code from your organiser, or start a group of your own.</p>
    </div>

    <%= link_to "Join a group", join_path, class: "button min-h-13 text-base" %>
    <%= link_to "Start a new group", new_group_path, class: "flex items-center justify-center min-h-12 text-[15px] font-medium" %>
  <% end %>
</section>
