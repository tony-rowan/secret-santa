<div class="flex flex-col gap-6">
  <%= link_to dashboard_path, class: "self-start flex items-center gap-1.5 min-h-11 font-medium no-underline" do %>
    <%= icon(:chevron_left, size: "size-5") %>
    Back
  <% end %>

  <h1 class="display-title">Edit your account</h1>

  <%= form_with(model: user, class: "card") do |form| %>
    <%= form.text_field :name, required: true, autocomplete: "name" %>
    <%= form.email_field :email, autocomplete: "email", hint: "We'll send a link to the new address to confirm it" %>

    <%= form.submit "Update Account", class: "w-full mt-2" %>
  <% end %>

  <% if user.unconfirmed_email.present? %>
    <div class="card items-center text-center">
      <p>Waiting for you to confirm <strong class="font-semibold"><%= user.unconfirmed_email %></strong></p>
      <%= button_to "Cancel change", email_confirmation_path, method: :delete, class: "button-secondary w-full" %>
    </div>
  <% end %>
</div>
