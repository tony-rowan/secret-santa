<!DOCTYPE html>
<html>
  <head>
    <title>Secret Santa</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "fraunces-font", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/snow" %>

    <div class="min-h-screen flex flex-col">
      <main class="grow flex flex-col justify-center w-full max-w-md mx-auto px-6 py-12">
        <%= link_to root_path, class: "flex flex-col items-center gap-4 mb-9 text-center text-snow hover:text-snow no-underline" do %>
          <span class="size-22 rounded-[28px] bg-night-800 border-[1.5px] border-gold text-gold flex items-center justify-center ring-8 ring-gold/12">
            <%= icon(:gift, size: "size-11") %>
          </span>
          <span class="font-display font-bold text-[40px] leading-none tracking-tight">Secret Santa</span>
          <span class="text-lg text-lilac-300 max-w-72">Draw names, share gift ideas, and keep the surprise.</span>
        <% end %>

        <%= render "shared/flashes" %>

        <%= yield %>
      </main>

      <p class="px-6 pb-10 text-sm text-lilac-500 text-center">Ho ho ho, and good luck keeping it a secret.</p>
    </div>
  </body>
</html>
