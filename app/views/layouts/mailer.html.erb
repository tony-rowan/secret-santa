<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="margin: 0; padding: 0; background-color: #f4f1ea; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f1ea;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; background-color: #ffffff; border-radius: 8px; overflow: hidden;">
            <tr>
              <td style="background-color: #166534; padding: 16px 24px; color: #ffffff; font-size: 20px; font-weight: bold;">
                Secret Santa
              </td>
            </tr>
            <tr>
              <td style="padding: 24px; font-size: 16px; line-height: 1.5;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding: 16px 24px; border-top: 4px solid #b91c1c; font-size: 12px; color: #6b7280;">
                Happy gifting!
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
