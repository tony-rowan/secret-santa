<!DOCTYPE html>
<html>
  <head>
    <title>Secret Santa</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "shared/head_icons" %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "fraunces-font", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/snow" %>

    <%= render "shared/navigation" %>

    <main class="<%= content_for?(:wide) ? "max-w-6xl lg:px-8" : "max-w-xl" %> mx-auto px-5 pt-3 pb-16">

      <%= yield %>
    </main>

    <%= render "shared/confirm_dialog" %>
  </body>
</html>
