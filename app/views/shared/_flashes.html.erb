<% flash_styles = {
  error: "bg-[#3c0e12]/80 border-[#ff8a8a] text-berry-light",
  success: "bg-pine/80 border-pine-light text-snow",
  notice: "bg-night-800/90 border-gold text-snow"
} %>

<% flash_styles.each do |type, classes| %>
  <% Array.wrap(flash[type]).each do |message| %>
    <div class="mb-5 rounded-2xl border-[1.5px] px-4 py-3 text-center <%= classes %>">
      <%= message %>
    </div>
  <% end %>
<% end %>
