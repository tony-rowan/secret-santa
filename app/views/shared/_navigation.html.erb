<%# Same size on every page, whatever the width of the content below it %>
<header class="max-w-6xl mx-auto flex items-center justify-between gap-4 min-h-17 lg:min-h-21 py-3 pl-5 pr-3 lg:px-8">
  <%= link_to dashboard_path, class: "flex items-center gap-2.5 lg:gap-3 text-snow hover:text-snow no-underline" do %>
    <%= icon(:gift, size: "size-7 lg:size-[30px]", class: "text-gold") %>
    <span class="font-display font-bold text-xl lg:text-2xl">Secret Santa</span>
  <% end %>

  <% if Current.user %>
    <%= link_to edit_user_path(Current.user),
      class: "flex items-center justify-center gap-2 size-11 lg:w-auto lg:pl-3 lg:pr-4 rounded-full border-[1.5px] border-night-600 bg-night-800 hover:bg-night-700 text-snow hover:text-snow font-semibold text-[15px] no-underline" do %>
      <%= icon(:user, size: "size-5") %>
      <span class="sr-only lg:not-sr-only">Account</span>
    <% end %>
  <% end %>
</header>
