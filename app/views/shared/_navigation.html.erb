<header class="<%= content_for?(:wide) ? "max-w-5xl" : "max-w-xl" %> mx-auto flex items-center justify-between gap-4 py-3 pl-5 pr-3">
  <%= link_to dashboard_path, class: "flex items-center gap-2.5 text-snow hover:text-snow no-underline" do %>
    <%= icon(:gift, size: "size-7", class: "text-gold") %>
    <span class="font-display font-bold text-xl">Secret Santa</span>
  <% end %>

  <% if Current.user %>
    <details class="relative">
      <summary
        aria-label="Account and sign out"
        title="Account and sign out"
        class="list-none [&::-webkit-details-marker]:hidden size-11 rounded-full border-[1.5px] border-night-600 bg-night-800 hover:bg-night-700 flex items-center justify-center cursor-pointer">
        <%= icon(:user, size: "size-5") %>
      </summary>

      <div class="absolute right-0 top-full mt-2 z-10 w-56 p-2 rounded-2xl bg-night-800 border border-white/15 shadow-2xl shadow-black/50">
        <p class="px-4 pt-2 pb-3 text-sm text-lilac-400 truncate"><%= Current.user.name %></p>

        <%= link_to edit_user_path(Current.user), class: "nav-item no-underline" do %>
          <%= icon(:user_circle, size: "size-5") %>
          <span>Account</span>
        <% end %>

        <%= button_to session_path, method: :delete, class: "nav-item" do %>
          <%= icon(:arrow_right_start_on_rectangle, size: "size-5") %>
          <span>Sign out</span>
        <% end %>
      </div>
    </details>
  <% end %>
</header>
