<% if group %>
  <% content_for :icon, "ticket" %>
  <% content_for :title, "You're invited" %>
  <% content_for :subtitle, "Check the details, then join." %>
<% else %>
  <% content_for :icon, "users" %>
  <% content_for :title, "Join a group" %>
  <% content_for :subtitle, "Enter the code your organiser shared with you." %>
<% end %>

<div class="contents">
  <% if group %>

    <section aria-labelledby="invite-heading" class="card gap-4 py-5.5">
      <div class="flex flex-col gap-1">
        <h2 id="invite-heading" class="font-display font-bold text-3xl leading-tight break-words"><%= group.name %></h2>
        <p class="text-lilac-400">Organised by <%= group.owner.name %></p>
      </div>

      <div class="flex items-center justify-between gap-3 px-4 py-3 rounded-2xl bg-night-900">
        <span class="text-sm text-lilac-400">Join code</span>
        <span class="text-lg font-bold tracking-[3px] text-gold break-all"><%= group.join_code %></span>
      </div>
    </section>

    <div class="flex flex-col gap-2">
      <%= form_with(model: form, url: join_path) do |form| %>
        <%= form.hidden_field :join_code %>
        <%= form.button "Join #{group.name}", class: "button w-full" %>
      <% end %>

      <%= link_to "Use a different code", join_path(join_code: ""), class: "flex items-center justify-center min-h-12 text-[15px] font-medium" %>
    </div>
  <% else %>

    <%= form_with(model: form, url: join_path, class: "flex flex-col gap-3") do |form| %>
      <%= form.text_field :join_code,
        autocomplete: "off",
        autocapitalize: "characters",
        spellcheck: false,
        field_classes: "text-2xl font-semibold tracking-[3px] uppercase text-center" %>

      <%= form.submit "Join group", class: "w-full" %>
    <% end %>

    <div class="flex items-center gap-3 text-sm text-lilac-500" aria-hidden="true">
      <span class="grow h-px bg-night-700"></span>
      <span>or</span>
      <span class="grow h-px bg-night-700"></span>
    </div>

    <%= link_to "Start a new group", new_group_path, class: "button-secondary" %>

    <% if Current.user.groups.any? %>
      <%= link_to "Back to your group", dashboard_path, class: "-mt-4 flex items-center justify-center min-h-12 text-[15px] font-medium" %>
    <% end %>
  <% end %>
</div>
