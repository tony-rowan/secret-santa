<%# locals: (group:, user:, groups:, pair:, ideas:, idea_counts:) %>

<% content_for :wide, true %>

<div class="flex items-center gap-2 px-1 mb-5">
  <%= render Dashboard::GroupTitleComponent.new(group:, groups:, user:) %>
</div>

<%# One column on phones (ideas second); on desktop the ideas get the right-hand column. Members
    leave from the account page, alongside their other groups. %>
<div class="flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:items-start lg:gap-6">
  <div class="contents lg:flex lg:flex-col lg:gap-5">
    <div class="order-1"><%= render Dashboard::StatusComponent.new(group:, user:, pair:, idea_counts:) %></div>
    <div class="order-3"><%= render Dashboard::MembersComponent.new(group:, user:, idea_counts:) %></div>
    <div class="order-3 empty:hidden"><%= render Dashboard::RulesComponent.new(group:, user:) %></div>
    <div class="order-3 empty:hidden"><%= render Dashboard::GroupNameComponent.new(group:, user:) %></div>
    <div class="order-3 empty:hidden"><%= render Dashboard::ResetComponent.new(group:, user:) %></div>
  </div>

  <div class="order-2 lg:sticky lg:top-6">
    <%= render Dashboard::IdeasComponent.new(ideas:, drawn: pair.present?) %>
  </div>
</div>
