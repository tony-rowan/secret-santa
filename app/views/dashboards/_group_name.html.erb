<%# locals: (group:) %>

<section aria-labelledby="group-name-heading" class="card gap-3">
  <h2 id="group-name-heading" class="card-title"><label for="group_name">Group name</label></h2>

  <%= form_with(model: group, class: "flex gap-2") do |form| %>
    <%= form.text_field :name,
      tailwindified: true,
      required: true,
      autocomplete: "off",
      class: "input-field grow min-w-0" %>
    <%= form.button "Update", class: "button-secondary bg-night-900 min-h-13 text-base px-4.5" %>
  <% end %>
</section>
