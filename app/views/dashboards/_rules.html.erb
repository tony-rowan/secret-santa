<%# locals: (group:, owner:) %>

<% rules = group.rules.to_a %>

<section aria-labelledby="rules-heading" class="card">
  <div class="flex flex-col gap-1">
    <h2 id="rules-heading" class="card-title">Rules</h2>
    <% if owner %>
      <p class="card-hint">Everyone in the group sees these.</p>
    <% end %>
  </div>

  <% if owner %>
    <% if rules.any? %>
      <ul class="flex flex-col gap-2">
        <% rules.each do |rule| %>
          <li class="list-row">
            <%= icon(:star_four, size: "size-3.5", class: "text-gold") %>
            <span class="grow min-w-0 break-words"><%= rule.text %></span>
            <%= button_to group_rule_path(group, rule),
              method: :delete,
              class: "icon-button",
              title: "Remove rule: #{rule.text}",
              aria: { label: "Remove rule: #{rule.text}" } do %>
              <%= icon(:x_mark, size: "size-5") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with(model: Rule.new, url: group_rules_path(group), class: "flex gap-2") do |form| %>
      <%= form.label :text, "Add a rule", class: "sr-only" %>
      <%= form.text_field :text,
        tailwindified: true,
        required: true,
        maxlength: 200,
        autocomplete: "off",
        class: "input-field grow min-w-0",
        placeholder: rules.any? ? "Add a rule…" : "e.g. Keep it under £20" %>
      <%= form.button class: "button min-h-13 text-base px-4.5" do %>
        <%= icon(:plus, size: "size-5", "stroke-width": 2.4) %>
        Add
      <% end %>
    <% end %>
  <% else %>
    <ul class="flex flex-col gap-2.5 text-lilac-200">
      <% rules.each do |rule| %>
        <li class="flex gap-2.5">
          <%= icon(:star_four, size: "size-3.5", class: "text-gold mt-1") %>
          <span class="min-w-0 break-words"><%= rule.text %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
