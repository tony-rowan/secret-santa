<%# locals: (group:) %>

<% member_count = group.users.count %>

<section aria-labelledby="reset-heading" class="card-danger">
  <h2 id="reset-heading" class="card-title">Reset for this year</h2>
  <p class="text-sm text-[#e7c9c9]">Clears everyone's gift ideas and un-draws names, ready to start this year's Secret Santa. Members stay in the group.</p>

  <%= render "shared/confirm_details",
    id: "confirm-reset",
    icon_name: :arrow_path,
    removed: ["Everyone's gift ideas are deleted", "Drawn names are cleared"],
    kept: ["All #{pluralize(member_count, "member")} stay in the group", "The rules stay as they are"],
    note: "This can't be undone." %>

  <%= button_to group_reset_path(group),
    class: "button-danger w-full",
    data: {
      turbo_confirm: "Clear everything?",
      confirm_button: "Yes, clear everything",
      confirm_details: "confirm-reset"
    } do %>
    <%= icon(:arrow_path, size: "size-5") %>
    Clear everything…
  <% end %>
</section>
