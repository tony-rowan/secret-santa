<%# The group name doubles as a menu for people in more than one group %>
<details class="relative min-w-0 group/switcher"
  data-controller="menu"
  data-action="click@window->menu#closeOnOutsideClick keydown.esc->menu#close">
  <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-flex items-center gap-3 min-h-11 max-w-full"
    aria-label="<%= group.name %>, switch group"
    title="Switch group">
    <h1 class="display-title min-w-0 break-words"><%= group.name %></h1>
    <span class="size-8 shrink-0 rounded-full bg-night-800 border-[1.5px] border-night-600 text-gold flex items-center justify-center">
      <%= icon(:chevron_down, size: "size-4.5", "stroke-width": 2.4, class: "transition-transform group-open/switcher:rotate-180") %>
    </span>
  </summary>

  <div class="absolute z-20 top-full left-0 mt-2 w-[min(24rem,calc(100vw-2.5rem))] p-2 flex flex-col gap-1 rounded-[20px] bg-[#2e2766] border border-white/14 shadow-[0_24px_60px_rgba(0,0,0,0.55)]">
    <p class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-[0.6px] text-lilac-400">Your groups</p>
    <ul aria-label="Switch group" class="flex flex-col gap-0.5">
      <% groups.each do |other| %>
        <% current = other == group %>
        <li>
          <%= link_to dashboard_path(group_id: other.id),
            aria: { current: current },
            class: "flex items-center gap-3 min-h-14 px-3 py-2 rounded-xl no-underline text-snow hover:text-snow #{current ? "bg-gold/12" : "hover:bg-white/6"}" do %>
            <span class="grow min-w-0 flex flex-col gap-0.5">
              <span class="font-semibold break-words"><%= other.name %></span>
              <% if other.owner?(Current.user) %>
                <span class="text-[13px] font-semibold text-gold">Organised by you</span>
              <% else %>
                <span class="text-[13px] text-lilac-400">Organised by <%= other.owner.name %></span>
              <% end %>
            </span>
            <% if current %>
              <%= icon(:check, size: "size-5", class: "text-gold", "stroke-width": 2.4) %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <span class="h-px mx-3 my-1 bg-night-600"></span>
    <%= link_to join_path, class: "flex items-center gap-2.5 min-h-12 px-3 rounded-xl text-[15px] font-semibold no-underline hover:bg-white/6" do %>
      <%= icon(:plus, size: "size-4.5", "stroke-width": 2.4) %>
      Join another group
    <% end %>
  </div>
</details>
