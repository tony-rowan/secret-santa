<%# locals: (group:) %>

<% content_for :icon, "check" %>
<% content_for :title, "#{group.name} is ready" %>
<% content_for :subtitle, "Now invite everyone. Share the code or send the link." %>

<div class="flex flex-col gap-2.5">
  <span class="font-semibold">Join code</span>
  <div class="join-code min-h-19"><%= group.formatted_join_code %></div>
  <%= render "groups/invite_buttons", group: %>
</div>

<%= link_to "Go to your group", dashboard_path, class: "button" %>
