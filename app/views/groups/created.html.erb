<%# locals: (group:) %>

<% content_for :icon, "check" %>
<% content_for :title, "#{group.name} is ready" %>
<% content_for :subtitle, "Now invite everyone you're swapping gifts with. They join by opening your invite link." %>

<div class="flex flex-col gap-3">
  <%= render Groups::InviteComponent.new(group:, primary: true) %>
  <p class="text-sm text-center text-lilac-400">The link works until you draw names.</p>
</div>

<%= link_to "Go to your group", dashboard_path, class: "button-secondary" %>
