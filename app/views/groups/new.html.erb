<%# locals: (group:, user:) %>

<% content_for :icon, "plus" %>
<% content_for :title, "Start a group" %>
<% content_for :subtitle, "You'll be the organiser. You can change all of this later." %>

<div class="flex flex-col gap-6">
  <%= form_with(model: group, class: "flex flex-col gap-5") do |form| %>
    <%= form.text_field :name, label: "Group name", placeholder: "e.g. The Rowans" %>

    <%= render Groups::RuleListComponent.new(rules: group.rules) %>

    <div class="flex flex-col gap-3">
      <%= form.submit "Create group", class: "w-full" %>
      <%= render Groups::InviteReminderComponent.new(user:) %>
    </div>
  <% end %>
</div>
