<div class="flex flex-col gap-6">
  <%= link_to dashboard_path, class: "self-start flex items-center gap-1.5 min-h-11 font-medium no-underline" do %>
    <%= icon(:chevron_left, size: "size-5") %>
    Back
  <% end %>

  <h1 class="display-title">Rename <%= group.name %></h1>

  <%= form_with(model: group, class: "flex flex-col gap-5") do |form| %>
    <%= form.text_field :name, label: "Group name" %>

    <%= form.submit "Save name", class: "w-full" %>
  <% end %>
</div>
