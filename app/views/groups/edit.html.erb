<% content_for :icon, "pencil_square" %>
<% content_for :title, "Rename #{group.name}" %>

<%= form_with(model: group, class: "flex flex-col gap-5") do |form| %>
  <%= form.text_field :name, label: "Group name" %>

  <div class="flex flex-col gap-2">
    <%= form.submit "Save name", class: "w-full" %>
    <%= link_to "Back to your group", dashboard_path(group_id: group.id), class: "flex items-center justify-center min-h-12 text-[15px] font-medium" %>
  </div>
<% end %>
