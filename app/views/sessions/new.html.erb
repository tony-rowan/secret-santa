<%= render "section" do %>
  <h2 class="text-xl text-center">
    <% if group %>
      Sign in to join <%= group.owner.name %>'s group, <%= group.name %>
    <% else %>
      Sign in to your account
    <% end %>
  </h2>
<% end %>

<%= form_with(url: session_path, class: "max-w-screen-sm container mx-auto", data: {turbo: false}) do |form| %>
  <%= form.email_field :email, label: "Email", required: true, autocomplete: "email", autofocus: true %>

  <%= form.submit "Email me a sign-in link", class: "w-full mt-6" %>
<% end %>
