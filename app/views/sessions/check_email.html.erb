<%# locals: (group:, email:) %>

<% content_for :icon, "envelope" %>
<% content_for :title, "Check your email" %>
<% content_for :subtitle, render(Sessions::LinkSentComponent.new(email:, group:)) %>

<div class="flex flex-col gap-3">
  <%= button_to "Resend link", session_path, params: {email:}, class: "button-secondary w-full", form: {data: {turbo: false}} %>
  <%= link_to "Use a different email", new_session_path, class: "flex items-center justify-center min-h-12 font-medium" %>
  <p class="text-sm text-center text-lilac-400">Can't see it? Check your spam folder.</p>
</div>
