<%# locals: (title:, summary:) %>

<div class="flex flex-col gap-2">
  <h1 class="font-display font-bold text-[34px] leading-tight"><%= title %></h1>
  <p class="text-sm text-lilac-500">Last updated 20 November 2026</p>
</div>

<div class="rounded-[18px] bg-gold/12 border border-gold/40 px-[18px] py-4 flex flex-col gap-1.5">
  <p class="text-[13px] font-semibold tracking-wide uppercase text-gold">The short version</p>
  <p class="text-[17px] leading-relaxed text-snow"><%= summary %></p>
</div>
